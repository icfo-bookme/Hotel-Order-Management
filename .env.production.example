# =====================================================================
# PRODUCTION ENVIRONMENT — copy to .env on the production server
#   cp .env.production.example .env
#   php artisan key:generate
# =====================================================================
APP_NAME=Hotel-Order-Management
APP_ENV=production
APP_KEY=
# MUST be false in production, otherwise stack traces leak to visitors
APP_DEBUG=false
# Real domain with HTTPS
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
# Use 'daily' to keep logs small on long-running servers:
# LOG_DAILY_DAYS=14

# --- Database (use a dedicated, least-privilege user, never root) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stmv1
DB_USERNAME=change_me
DB_PASSWORD=change_me

# --- Sessions / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Force cookies over HTTPS only
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite / Assets ---
VITE_APP_NAME="${APP_NAME}"
